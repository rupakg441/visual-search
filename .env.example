# ==========================================
# Visual Search Monorepo Environment Config
# ==========================================

# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOCAL_IMAGE_DIR=./data/images

# MongoDB (docker compose service by default; use localhost:27017 for host-run server)
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=visual_search
MONGODB_COLLECTION=product_images
CLICKS_COLLECTION=search_clicks

# Vector Search Mode:
#   atlas -> Uses MongoDB Atlas $vectorSearch aggregation pipeline
#   exact -> Computes exact cosine similarity (ideal for local MongoDB or small catalogs)
VECTOR_SEARCH_MODE=exact
ATLAS_VECTOR_INDEX=product_images_vector_index

# Redis & BullMQ Indexing Queue
REDIS_URL=redis://localhost:6379
INDEX_QUEUE_NAME=product-image-index
QUEUE_ENABLED=false

# ML Service Connection
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ML Model & Preprocessing Config (Python FastAPI)
MODEL_VERSION=openclip-vit-b32-v1
EMBEDDING_BACKEND=openclip
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
SIGLIP_MODEL=ViT-B-16-SigLIP
SIGLIP_PRETRAINED=webli
ENABLE_DINOV2=false
DINOV2_MODEL=facebook/dinov2-base
DINOV2_WEIGHT=0.35
ENABLE_ZERO_SHOT_ATTRIBUTES=true
FINETUNED_WEIGHTS_PATH=
DEVICE=auto
ENABLE_ONNX=false
ONNX_MODEL_DIR=./models/onnx

# Preprocessing Pipeline (shared across catalog & query)
MAX_IMAGE_BYTES=10485760
ENABLE_OBJECT_DETECTION=true
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.25
ENABLE_BG_REMOVAL=true
ENABLE_TTA=false

# Accuracy Modules (Express Ranking Pipeline)
ENABLE_HYBRID_RANKING=true
HYBRID_ATTR_BOOST=0.12
ENABLE_RERANKING=true
RERANK_CANDIDATES=50
TOP_RESULTS=20

# Client (Vite)
VITE_API_BASE_URL=http://localhost:4000
